{
  "author": {
    "name": "Lafitte Mehdy",
    "url": "https://github.com/lafittemehdy"
  },
  "bugs": {
    "url": "https://github.com/lafittemehdy/sway/issues"
  },
  "description": "A React component for smooth infinite scrolling, designed for creating engaging, continuous content streams with minimal configuration.",
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__"
  ],
  "homepage": "https://github.com/lafittemehdy/sway#readme",
  "keywords": [
    "content-stream",
    "continuous-scroll",
    "frontend",
    "infinite-scroll",
    "javascript",
    "react",
    "react-component",
    "scroller",
    "smooth-scroll",
    "typescript",
    "ui-component"
  ],
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "name": "react-sway",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lafittemehdy/sway.git"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite build --config vite.config.ts --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.3.0"
}
