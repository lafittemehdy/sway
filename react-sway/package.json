{
  "author": {
    "name": "Lafitte Mehdy",
    "url": "https://github.com/lafittemehdy"
  },
  "bugs": {
    "url": "https://github.com/lafittemehdy/sway/issues"
  },
  "description": "A React component for smooth infinite scrolling, designed for creating engaging, continuous content streams with minimal configuration.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "homepage": "https://github.com/lafittemehdy/sway#readme",
  "keywords": [
    "content-stream",
    "continuous-scroll",
    "frontend",
    "infinite-scroll",
    "javascript",
    "react",
    "react-component",
    "scroller",
    "smooth-scroll",
    "typescript",
    "ui-component"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "name": "react-sway",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lafittemehdy/sway.git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite build --config vite.config.ts --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.4.2"
}
